# App registration (client) ID used by the Azure Bot resource
BOT_APP_ID=

# Client secret for that app registration (local dev only — leave unset in Azure,
# where a managed identity + federated credential is used instead; see README)
BOT_APP_SECRET=

# Your Entra tenant ID (required for single-tenant bots; leave empty for multi-tenant)
TENANT_ID=

PORT=3000
